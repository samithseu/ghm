{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt cleanup && nuxt build",
    "clean": "nuxt cleanup",
    "clean:all": "nuxt cleanup && rm -rf ./node_modules/ ./.output ./.vercel",
    "dev": "nuxt cleanup && nuxt dev",
    "generate": "nuxt generate",
    "preview": "NITRO_PRESET=node-server nuxt build && node .output/server/index.mjs",
    "preview:vercel": "vercel deploy --prebuilt",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/seo": "^5.3.16",
    "@takumi-rs/core": "^2.14.0",
    "@unhead/vue": "^3.4.1",
    "nuxt": "^4.5.2",
    "unstorage": "^1.17.5",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@iconify-json/lineicons": "^1.2.6",
    "@iconify-json/lucide": "^1.2.133",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
